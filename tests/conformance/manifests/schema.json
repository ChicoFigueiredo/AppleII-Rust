{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChicoFigueiredo/AppleII-Rust/tests/conformance/manifests/schema.json",
  "title": "Manifesto de execução de conformidade",
  "description": "Um manifesto por execução de teste (plano, secção 17). Campos sem valor conhecido são null, nunca omitidos.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_id",
    "user_story",
    "acceptance_criterion",
    "applewin_sha",
    "rust_sha",
    "fixture_sha256",
    "rom_sha256",
    "machine_model",
    "cpu_model",
    "cards_slots",
    "host_os",
    "host_arch",
    "toolchain",
    "input_trace",
    "command",
    "expected",
    "actual",
    "diff_artifact",
    "result",
    "timestamp_utc",
    "reviewer"
  ],
  "properties": {
    "test_id": { "type": "string", "minLength": 1, "description": "Identificador do caso." },
    "user_story": { "type": "string", "minLength": 1, "description": "História (HU-xxxx)." },
    "acceptance_criterion": { "type": "string", "minLength": 1, "description": "Critério de aceite (CA)." },
    "applewin_sha": { "type": ["string", "null"], "description": "SHA congelado do AppleWin usado como oráculo; null se o oráculo não é o AppleWin." },
    "rust_sha": { "type": "string", "minLength": 1, "description": "SHA do AppleII-Rust que executou o teste." },
    "fixture_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 da fixture; null se o caso não usa fixture." },
    "rom_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 da ROM de sistema usada; null se não foi possível determinar." },
    "machine_model": { "type": "string", "minLength": 1 },
    "cpu_model": { "type": "string", "minLength": 1 },
    "cards_slots": { "type": "string", "minLength": 1, "description": "Ex.: \"0=LanguageCard16K,3=Saturn128K\" ou \"none\"." },
    "host_os": { "type": "string", "minLength": 1 },
    "host_arch": { "type": "string", "minLength": 1 },
    "toolchain": { "type": "string", "minLength": 1 },
    "input_trace": { "type": ["string", "null"], "description": "Sequência de entrada (teclas por quadro/ciclo) ou caminho do trace de entrada; null se não há entrada." },
    "command": { "type": "string", "minLength": 1 },
    "expected": { "type": "string", "description": "Resultado esperado e sua fonte (oráculo)." },
    "actual": { "type": "string", "description": "Resultado obtido, ou a causa quando BLOCKED." },
    "diff_artifact": { "type": ["string", "null"], "description": "Caminho (relativo ao diretório do relatório) do artefato de diff; null se não houve FAIL." },
    "result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_APPLICABLE", "BLOCKED", "IMPLEMENTED"]
    },
    "timestamp_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "reviewer": { "type": ["string", "null"], "description": "Quem revisou o resultado; null até haver revisão humana." }
  }
}
