+// Conformance oracle: g_nCumulativeCycles is only synced lazily (CpuCalcCycles), hence the correction below.
+// P is rebuilt from the split flags exactly as EF_TO_AF does (bits 5 and 4 always set).
+#define ORACLE_TRACE(op)															\
+		if (g_pfnCpuTraceHook)														\
+			g_pfnCpuTraceHook(g_nCumulativeCycles - g_nCyclesExecuted + uExecutedCycles,	\
+				(uint16_t)(regs.pc - 1), (op), regs.a, regs.x, regs.y, (uint8_t)regs.sp,	\
+				(uint8_t)((regs.ps & ~(AF_CARRY | AF_SIGN | AF_OVERFLOW | AF_ZERO))	\
+					| flagc | flagn | (flagv ? AF_OVERFLOW : 0) | (flagz ? AF_ZERO : 0)	\
+					| AF_RESERVED | AF_BREAK));
 // CYC(a): This can be optimised, as only certain opcodes will affect uExtraCycles
 #define CYC(a)	 uExecutedCycles += (a)+uExtraCycles;
 
