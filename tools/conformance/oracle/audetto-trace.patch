--- a/source/Memory.cpp
+++ b/source/Memory.cpp
@@ -2282,6 +2282,7 @@
 
 inline uint32_t getRandomTime()
 {
+	if (g_bOracleDeterministic) return 0;	// conformance oracle: reproducible power-on RAM
 	return rand() ^ timeGetTime(); // We can't use g_nCumulativeCycles as it will be zero on a fresh execution.
 }
 
