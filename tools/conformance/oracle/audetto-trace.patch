 extern regsrec    regs;
+// Conformance oracle trace hook (tools/conformance/oracle/audetto-trace.patch).
+// Called once per instruction, after the opcode fetch and before execution. NULL = disabled.
+typedef void (*CpuTraceHook_t)(uint64_t cycle, uint16_t pc, uint8_t op, uint8_t a, uint8_t x, uint8_t y, uint8_t sp, uint8_t p);
+extern CpuTraceHook_t g_pfnCpuTraceHook;
+// Conformance oracle: when true, memory power-on init uses no wall-clock randomness (see Memory.cpp getRandomTime).
+extern bool g_bOracleDeterministic;
 extern unsigned __int64 g_nCumulativeCycles;
 
